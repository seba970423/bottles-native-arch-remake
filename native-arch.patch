new file mode 100644
index 0000000..ccde842
--- /dev/null
+++ b/bottles/backend/umu/dxvk_override.py
@@ -0,0 +1,156 @@
+import json
+import os
+import re
+import shutil
+import tempfile
+from pathlib import Path
+from uuid import uuid4
+
+from bottles.backend.globals import Paths
+from bottles.backend.umu.models import UmuGame
+
+
+DXVK_DLLS = ("d3d8.dll", "d3d9.dll", "d3d10core.dll", "d3d11.dll", "dxgi.dll")
+DXVK_OVERRIDE_KEYS = "d3d8,d3d9,d3d10core,d3d11,dxgi"
+_SAFE_COMPONENT = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._+-]*$")
+
+
+class UmuDxvkOverrideError(RuntimeError):
+    pass
+
+
+class UmuDxvkOverride:
+    """Transactional, per-prefix DXVK override for managed UMU games."""
+
+    def __init__(self, prefix: Path):
+        self.prefix = prefix.resolve(strict=False)
+        self.state = self.prefix / ".bottles" / "dxvk-override"
+        self.manifest = self.state / "manifest.json"
+
+    @staticmethod
+    def _targets(prefix: Path):
+        windows = prefix / "drive_c" / "windows"
+        for architecture, directory in (("x64", "system32"), ("x32", "syswow64")):
+            for dll in DXVK_DLLS:
+                yield architecture, dll, windows / directory / dll
+
+    @staticmethod
+    def _atomic_copy(source: Path, target: Path):
+        target.parent.mkdir(parents=True, exist_ok=True)
+        fd, temporary_name = tempfile.mkstemp(dir=target.parent)
+        os.close(fd)
+        temporary = Path(temporary_name)
+        try:
+            shutil.copyfile(source, temporary)
+            os.replace(temporary, target)
+        finally:
+            temporary.unlink(missing_ok=True)
+
+    @staticmethod
+    def _atomic_symlink(link_target: str, target: Path):
+        target.parent.mkdir(parents=True, exist_ok=True)
+        temporary = target.with_name(f".{target.name}.{uuid4().hex}.tmp")
+        try:
+            temporary.symlink_to(link_target)
+            os.replace(temporary, target)
+        finally:
+            temporary.unlink(missing_ok=True)
+
+    def restore(self) -> bool:
+        if not self.manifest.is_file():
+            return False
+        try:
+            data = json.loads(self.manifest.read_text(encoding="utf-8"))
+            entries = data["files"]
+            for entry in entries:
+                target = self.prefix / entry["target"]
+                target.relative_to(self.prefix)
+                kind = entry["kind"]
+                if kind == "missing":
+                    target.unlink(missing_ok=True)
+                elif kind == "symlink":
+                    self._atomic_symlink(entry["link_target"], target)
+                elif kind == "file":
+                    backup = self.state / entry["backup"]
+                    backup.relative_to(self.state)
+                    self._atomic_copy(backup, target)
+                else:
+                    raise UmuDxvkOverrideError("Invalid DXVK backup manifest")
+            self.manifest.unlink(missing_ok=True)
+            return True
+        except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError) as error:
+            raise UmuDxvkOverrideError(
+                f"Could not restore the bundled Proton DXVK: {error}"
+            ) from error
+
+    def apply(self, version: str) -> None:
+        if not _SAFE_COMPONENT.fullmatch(version):
+            raise UmuDxvkOverrideError("Invalid DXVK component name")
+        source_root = Path(Paths.dxvk) / version
+        sources = []
+        for architecture, dll, target in self._targets(self.prefix):
+            source = source_root / architecture / dll
+            if not source.is_file():
+                raise UmuDxvkOverrideError(f"DXVK {version} is incomplete: {source}")
+            sources.append((source, target))
+
+        self.restore()
+        generation = uuid4().hex
+        self.state.mkdir(parents=True, exist_ok=True)
+        entries = []
+        try:
+            for _source, target in sources:
+                relative = str(target.relative_to(self.prefix))
+                if target.is_symlink():
+                    entries.append(
+                        {
+                            "target": relative,
+                            "kind": "symlink",
+                            "link_target": os.readlink(target),
+                        }
+                    )
+                elif target.exists():
+                    backup_name = f"{generation}-{len(entries)}.dll"
+                    shutil.copy2(target, self.state / backup_name)
+                    entries.append(
+                        {"target": relative, "kind": "file", "backup": backup_name}
+                    )
+                else:
+                    entries.append({"target": relative, "kind": "missing"})
+
+            temporary_manifest = self.state / f"manifest-{generation}.tmp"
+            temporary_manifest.write_text(
+                json.dumps({"version": version, "files": entries}, indent=2),
+                encoding="utf-8",
+            )
+            os.replace(temporary_manifest, self.manifest)
+            for source, target in sources:
+                self._atomic_copy(source, target)
+        except Exception as error:
+            try:
+                self.restore()
+            except UmuDxvkOverrideError as restore_error:
+                raise UmuDxvkOverrideError(
+                    f"DXVK apply failed and rollback also failed: {restore_error}"
+                ) from error
+            raise UmuDxvkOverrideError(f"Could not apply DXVK {version}: {error}") from error
+
+
+def configure_dxvk_environment(game: UmuGame, prefix: Path, environment: dict[str, str]):
+    selection = game.extra.get("dxvk_override", "proton")
+    if selection == "wined3d":
+        if game.prefix.managed:
+            UmuDxvkOverride(prefix).restore()
+        environment["PROTON_USE_WINED3D"] = "1"
+        return
+    if not game.prefix.managed:
+        return
+    override = UmuDxvkOverride(prefix)
+    if selection == "proton":
+        override.restore()
+        return
+    environment.pop("PROTON_USE_WINED3D", None)
+    override.apply(selection)
+    existing = environment.get("WINEDLLOVERRIDES", "").strip(";")
+    native = f"{DXVK_OVERRIDE_KEYS}=n,b"
+    environment["WINEDLLOVERRIDES"] = f"{existing};{native}" if existing else native
