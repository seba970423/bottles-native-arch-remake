+                message=_("Stop all UMU games before changing the UMU data folder."),
+            )
+
+        candidate = os.path.abspath(os.path.expanduser(value))
+        if not os.path.isdir(candidate) or not os.access(candidate, os.W_OK):
+            return Result(False, message=_("Select an existing writable folder."))
+
+        repository = UmuGameRepository(candidate)
+        database = UmuDatabaseClient(repository.root / "cache" / "umu-database.json")
+        executor = None
+        if self._umu_installation is not None:
+            executor = UmuExecutor(
+                self._umu_installation,
+                data_root=repository.root,
+                proton_resolver=self.umu_proton_catalog.resolve_value,
+            )
+
+        # Keep the repository object itself stable because list/preferences views
+        # hold references to it. Change its validated roots only after all new
+        # state has been constructed successfully.
