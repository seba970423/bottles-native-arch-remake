diff --git a/bottles/backend/umu/gamescope.py b/bottles/backend/umu/gamescope.py
new file mode 100644
index 0000000..66bdf2b
--- /dev/null
+++ b/bottles/backend/umu/gamescope.py
@@ -0,0 +1,160 @@
+"""Validated, optional Gamescope commands for UMU; no shell or prefix changes."""
+
+import re
+import shutil
+from collections.abc import Mapping
+from dataclasses import asdict, dataclass
+from gettext import gettext as _
+
+GAMESCOPE_FILTER_IDS = ("linear", "fsr", "nis", "integer", "nearest")
+GAMESCOPE_RESOLUTION_PRESETS = (
+    "640x480", "800x600", "1024x768", "1280x720", "1280x800", "1280x1024",
+    "1366x768", "1440x900", "1600x900", "1680x1050", "1920x1080", "1920x1200",
+    "2560x1080", "2560x1440", "2560x1600", "3440x1440", "3840x2160",
+    "5120x1440", "7680x4320",
+)
+GAMESCOPE_RESOLUTION_IDS = ("", *GAMESCOPE_RESOLUTION_PRESETS, "custom")
+_RESOLUTION = re.compile(r"\s*([0-9]{1,5})\s*[xX×]\s*([0-9]{1,5})\s*")
+
+
+def parse_resolution(value: object) -> tuple[int, int] | None:
+    if isinstance(value, str):
+        if not value.strip():
+            return None
+        match = _RESOLUTION.fullmatch(value)
+        if match:
+            width, height = map(int, match.groups())
+            if 1 <= width <= 16384 and 1 <= height <= 16384:
+                return width, height
+    raise ValueError(_("Use a resolution such as 1280x720, or leave it empty."))
+
+
+def resolution_preset(value: object) -> str:
+    """Map an existing resolution to a dropdown without discarding custom sizes."""
+    size = parse_resolution(value)
+    resolution = "{}x{}".format(*size) if size else ""
+    return resolution if resolution in GAMESCOPE_RESOLUTION_IDS else "custom"
+
+
+def resolution_from_preset(preset: object, custom: object = "") -> str:
+    if preset == "custom":
+        size = parse_resolution(custom)
+        if size is None:
+            raise ValueError(_("Enter a custom resolution such as 1280x720."))
+        return "{}x{}".format(*size)
+    if isinstance(preset, str) and preset in GAMESCOPE_RESOLUTION_IDS:
+        return preset
+    raise ValueError(_("Select a valid Gamescope resolution."))
+
+
+@dataclass(frozen=True)
+class GamescopeSettings:
+    enabled: bool = False
+    game_resolution: str = ""
+    output_resolution: str = ""
+    filter: str = "linear"
+    sharpness: int = 2
+    fps_limit: int = 0
+    fullscreen: bool = True
+
+    @classmethod
+    def from_dict(cls, value: object) -> "GamescopeSettings":
+        if value is None:
+            return cls()
+        if not isinstance(value, Mapping):
+            raise ValueError(_("Invalid Gamescope settings."))
+        settings = cls(
+            **{key: value.get(key, default) for key, default in asdict(cls()).items()}
+        )
+        if type(settings.enabled) is not bool or type(settings.fullscreen) is not bool:
+            raise ValueError(_("Invalid Gamescope switch value."))
+        for resolution in (settings.game_resolution, settings.output_resolution):
+            parse_resolution(resolution)
+        if (
+            not isinstance(settings.filter, str)
+            or settings.filter not in GAMESCOPE_FILTER_IDS
+        ):
+            raise ValueError(_("Invalid Gamescope scaling filter."))
+        if type(settings.sharpness) is not int or not 0 <= settings.sharpness <= 20:
+            raise ValueError(_("Gamescope sharpness must be between 0 and 20."))
+        if type(settings.fps_limit) is not int or not 0 <= settings.fps_limit <= 1000:
+            raise ValueError(_("Gamescope FPS limit must be between 0 and 1000."))
+        return settings
+
+    def to_dict(self) -> dict:
+        values = asdict(self)
+        for key in ("game_resolution", "output_resolution"):
+            resolution = parse_resolution(values[key])
+            values[key] = "{}x{}".format(*resolution) if resolution else ""
+        return values
+
+
+@dataclass(frozen=True)
+class GamescopeLaunch:
+    arguments: tuple[str, ...] = ()
+    reason: str = ""
+
+    @property
+    def active(self) -> bool:
+        return bool(self.arguments)
+
+
+def resolve_gamescope(value: object, environment: Mapping[str, str]) -> GamescopeLaunch:
+    # Legacy games and disabled settings must be exact no-ops, even when
+    # unused settings are malformed. Never infer opt-in from a truthy string.
+    if not isinstance(value, Mapping) or value.get("enabled") is not True:
+        return GamescopeLaunch()
+    try:
+        settings = GamescopeSettings.from_dict(value)
+    except ValueError as error:
+        return GamescopeLaunch(reason=str(error))
+    executable = shutil.which("gamescope", path=environment.get("PATH"))
+    if not executable:
+        return GamescopeLaunch(reason=_("Gamescope is not installed."))
+    if not environment.get("DISPLAY") and not environment.get("WAYLAND_DISPLAY"):
+        return GamescopeLaunch(reason=_("No desktop display is available for Gamescope."))
+
+    arguments = [executable]
+    for resolution, flags in (
+        (settings.game_resolution, ("-w", "-h")),
+        (settings.output_resolution, ("-W", "-H")),
+    ):
+        size = parse_resolution(resolution)
+        if size:
+            arguments.extend((flags[0], str(size[0]), flags[1], str(size[1])))
+    if settings.filter == "integer":
+        arguments.extend(("-S", "integer", "-F", "nearest"))
+    else:
+        arguments.extend(("-F", settings.filter))
+    if settings.filter in ("fsr", "nis"):
+        arguments.extend(("--sharpness", str(settings.sharpness)))
+    if settings.fps_limit:
+        arguments.extend(("-r", str(settings.fps_limit)))
+    if settings.fullscreen:
+        arguments.append("-f")
+    return GamescopeLaunch(tuple(arguments))
+
+
+def wrap_gamescope(
+    launch: GamescopeLaunch,
+    argv: tuple[str, ...],
+    environment: dict[str, str],
+    *,
+    mangohud_enabled: bool,
+) -> tuple[tuple[str, ...], str]:
+    if not launch.active:
+        return argv, ""
+    arguments = launch.arguments
+    reason = ""
+    # Gamescope owns the overlay. Do not load MangoHud into the compositor or
+    # inject its OpenGL wrapper into UMU, regardless of the selected renderer.
+    environment.pop("MANGOHUD", None)
+    if mangohud_enabled:
+        if shutil.which("mangoapp", path=environment.get("PATH")):
+            arguments = (*arguments, "--mangoapp")
+        else:
+            reason = _(
+                "MangoHud is enabled, but mangoapp is missing; install the "
+                "mangohud package for the Gamescope overlay."
+            )
+    return (*arguments, "--", *argv), reason
