+                    except GLib.Error:
+                        success = False
+                    available = success and all(
+                        (
+                            shutil.which("gamemoderun")
+                            if package == "gamemode"
+                            else shutil.which("system76-scheduler")
+                        )
+                        for package in packages
+                    )
+                    self.window.show_toast(
+                        _("Performance backend installed.")
+                        if available
+                        else _("The performance backend was not installed.")
+                    )
+                    if available and "system76-scheduler" in packages:
+                        self.__prepare_system76_enable()
+
+                process.wait_check_async(None, installed)
+
+            dialog.connect("response", response)
+            dialog.present(self)
+            return
+
+        if backend in ("system76", "both") and shutil.which("systemctl"):
+            active = subprocess.run(
+                (
+                    "systemctl",
+                    "is-active",
+                    "--quiet",
+                    "com.system76.Scheduler.service",
+                ),
+                check=False,
+            ).returncode == 0
+            if not active:
+                self.__prepare_system76_enable()
+
+    def __prepare_system76_enable(self):
+        helper = Path(
+            "/usr/lib/bottles-native-arch/system76-pipewire-workaround"
+        )
+        monitor_enabled = helper.is_file() and subprocess.run(
+            [str(helper), "status"],
+            check=False,
+        ).returncode == 0
+        if not monitor_enabled:
+            self.__prompt_enable_system76()
+            return
+
+        dialog = Adw.AlertDialog.new(
+            _("Disable Experimental PipeWire Monitoring?"),
+            _(
+                "System76 Scheduler's optional PipeWire monitor can repeatedly "
+                "crash on some Arch-based systems. Disabling it preserves the "
+                "core scheduler and normal sound-server priority assignments."
+            ),
+        )
+        dialog.add_response("keep", _("Keep Enabled"))
+        dialog.add_response("disable", _("Disable Monitor"))
+        dialog.set_default_response("disable")
+        dialog.set_close_response("keep")
+        dialog.set_response_appearance(
+            "disable", Adw.ResponseAppearance.SUGGESTED
+        )
+
+        def response(_dialog, response_id):
+            if response_id != "disable":
+                self.__prompt_enable_system76()
+                return
+            pkexec = shutil.which("pkexec")
+            if not pkexec:
+                self.window.show_toast(
+                    _("Polkit is unavailable; the monitor was not changed.")
+                )
+                self.__prompt_enable_system76()
+                return
+
+            def disable_monitor():
+                return subprocess.run(
+                    [pkexec, str(helper), "disable"],
+                    check=False,
+                    stdout=subprocess.PIPE,
+                    stderr=subprocess.PIPE,
+                    text=True,
+                    timeout=120,
+                )
+
+            def disabled(result, error=False):
+                success = (
+                    not error
+                    and result is not None
+                    and result.returncode == 0
+                    and subprocess.run(
+                        [str(helper), "status"], check=False
+                    ).returncode != 0
+                )
+                if not success and result is not None and result.stderr:
+                    logging.warning(
+                        "System76 PipeWire workaround failed: "
+                        f"{result.stderr.strip()}"
+                    )
+                self.window.show_toast(
+                    _("System76 PipeWire monitoring was disabled.")
+                    if success
+                    else _("System76 PipeWire monitoring was not changed.")
+                )
+                self.__prompt_enable_system76()
+
+            RunAsync(disable_monitor, callback=disabled)
+
+        dialog.connect("response", response)
+        dialog.present(self)
+
+    def __prompt_enable_system76(self):
+        dialog = Adw.AlertDialog.new(
+            _("Enable System76 Scheduler?"),
+            _(
+                "System76 Scheduler is a persistent system service. Enabling it "
+                "can optimize applications outside Bottles as well."
+            ),
+        )
+        dialog.add_response("cancel", _("Not Now"))
+        dialog.add_response("enable", _("Enable and Start"))
+        dialog.set_default_response("enable")
+        dialog.set_close_response("cancel")
+        dialog.set_response_appearance("enable", Adw.ResponseAppearance.SUGGESTED)
+
+        def response(_dialog, response_id):
+            if response_id != "enable":
+                return
+            pkexec = shutil.which("pkexec")
+            systemctl = shutil.which("systemctl")
+            if not pkexec or not systemctl:
+                self.window.show_toast(
+                    _("Enable com.system76.Scheduler.service with systemctl.")
+                )
+                return
+            unit = "com.system76.Scheduler.service"
+
+            def enable_service():
+                return subprocess.run(
+                    [pkexec, systemctl, "enable", "--now", unit],
+                    check=False,
+                    stdout=subprocess.PIPE,
+                    stderr=subprocess.PIPE,
+                    text=True,
+                    timeout=120,
+                )
+
+            def enabled(result, error=False):
+                enabled_now = subprocess.run(
+                    [systemctl, "is-enabled", "--quiet", unit],
+                    check=False,
+                ).returncode == 0
+                active_now = subprocess.run(
+                    [systemctl, "is-active", "--quiet", unit],
+                    check=False,
+                ).returncode == 0
+                success = (
+                    not error and result is not None and enabled_now and active_now
+                )
+                if not success and result is not None and result.stderr:
+                    logging.warning(
+                        "System76 Scheduler activation failed: "
+                        f"{result.stderr.strip()}"
+                    )
+                self.window.show_toast(
+                    _("System76 Scheduler is running.")
+                    if success
+                    else _("System76 Scheduler was not enabled.")
+                )
+
+            RunAsync(enable_service, callback=enabled)
+
+        dialog.connect("response", response)
+        dialog.present(self)
