new file mode 100644
index 0000000..45be1d7
--- /dev/null
+++ b/bottles/backend/umu/display_backend.py
@@ -0,0 +1,171 @@
+"""Launch-local Wine display selection; never edit the desktop or prefix registry."""
+
+import os
+import re
+import stat
+from collections.abc import Mapping
+from dataclasses import dataclass
+from gettext import gettext as _
+from pathlib import Path
+
+DISPLAY_BACKEND_IDS = ("proton", "wayland", "x11")
+_WAYLAND_KEYS = ("PROTON_ENABLE_WAYLAND", "PROTON_USE_WAYLAND")
+_DISPLAY_DRIVERS = {"winex11", "winex11.drv", "winewayland", "winewayland.drv"}
+_WAYLAND_CONTROL = re.compile(
+    r"check_environment\(\s*['\"]PROTON_(?:ENABLE|USE)_WAYLAND['\"]\s*,"
+    r"\s*['\"]wayland['\"]\s*\)"
+)
+
+
+@dataclass(frozen=True)
+class DisplayBackendResolution:
+    requested: str
+    backend: str
+    reason: str = ""
+
+    @property
+    def fallback(self) -> bool:
+        return self.requested != self.backend
+
+
+def _wayland_unavailable_reason(environment: Mapping[str, str]) -> str:
+    display = environment.get("WAYLAND_DISPLAY", "")
+    if not display:
+        return _("No Wayland display is available in this launch environment.")
+    socket_path = Path(display)
+    if not socket_path.is_absolute():
+        runtime = environment.get("XDG_RUNTIME_DIR", "")
+        if not runtime or not Path(runtime).is_absolute():
+            return _("The Wayland runtime directory is unavailable.")
+        socket_path = Path(runtime) / socket_path
+    try:
+        if not stat.S_ISSOCK(socket_path.stat().st_mode) or not os.access(
+            socket_path, os.R_OK | os.W_OK
+        ):
+            return _("The Wayland display socket is missing or inaccessible.")
+    except OSError:
+        return _("The Wayland display socket is missing or inaccessible.")
+
+    proton = Path(environment.get("PROTONPATH", "")).expanduser()
+    if not proton.is_absolute() or not proton.is_dir():
+        return _("Select an installed Proton runner to verify Wine-Wayland support.")
+    try:
+        # Inspect only the launcher, without executing it or downloading a runner.
+        with (proton / "proton").open(encoding="utf-8", errors="replace") as launcher:
+            source = launcher.read(2 * 1024 * 1024)
+    except OSError:
+        return _("The selected Proton launcher's Wayland controls could not be verified.")
+    if not _WAYLAND_CONTROL.search(source):
+        return _("The selected Proton launcher has no verified Wayland override.")
+
+    # Proton 10/11, classic multilib and new WoW64 layouts. A name alone is
+    # insufficient: require the actual Unix display driver as well.
+    for base in (proton / "files", proton / "dist", proton):
+        pe_driver_available = any(
+            (base / lib / "wine" / arch / "winewayland.drv").is_file()
+            for lib in ("lib64", "lib")
+            for arch in ("x86_64-windows", "i386-windows", "aarch64-windows")
+        )
+        for lib in ("lib64", "lib"):
+            wine = base / lib / "wine"
+            for arch in ("x86_64-unix", "i386-unix", "aarch64-unix", ""):
+                unix_directory = wine / arch
+                if (unix_directory / "winewayland.drv.so").is_file() or (
+                    pe_driver_available
+                    and (unix_directory / "winewayland.so").is_file()
+                ):
+                    return ""
+    return _("The selected Proton runner does not contain a complete Wine-Wayland driver.")
+
+
+def resolve_display_backend(
+    mode: object, environment: Mapping[str, str]
+) -> DisplayBackendResolution:
+    # Unknown persisted values behave like the default; malformed metadata must
+    # not introduce launch overrides or crash the launch.
+    if not isinstance(mode, str) or mode not in DISPLAY_BACKEND_IDS:
+        mode = "proton"
+    if mode == "proton":
+        return DisplayBackendResolution(mode, mode)
+    if mode == "wayland":
+        reason = _wayland_unavailable_reason(environment)
+        if not reason:
+            return DisplayBackendResolution(mode, mode)
+        fallback = "x11" if environment.get("DISPLAY") else "proton"
+        return DisplayBackendResolution(mode, fallback, reason)
+    if not environment.get("DISPLAY"):
+        return DisplayBackendResolution(
+            mode, "proton", _("No X11/XWayland display is available; using Proton Default.")
+        )
+    return DisplayBackendResolution(mode, mode)
+
+
+def _without_display_dll_overrides(value: str) -> str:
+    entries = []
+    for entry in value.split(";"):
+        names, separator, setting = entry.partition("=")
+        if not separator:
+            entries.append(entry)
+            continue
+        remaining = [
+            name for name in names.split(",")
+            if name.strip().lower() not in _DISPLAY_DRIVERS
+        ]
+        if len(remaining) == len(names.split(",")):
+            entries.append(entry)
+        elif remaining:
+            entries.append(",".join(remaining) + "=" + setting)
+    return ";".join(entries)
+
+
+def configure_display_environment(
+    mode: object, environment: dict[str, str], *, nested_x11: bool = False
+) -> DisplayBackendResolution:
+    # Gamescope creates its XWayland display after this command is prepared,
+    # including on Wayland-only desktops with no host DISPLAY. Do not insert
+    # a fake DISPLAY or preflight the host runner's Wayland driver in that case.
+    resolution = (
+        DisplayBackendResolution("x11", "x11") if nested_x11
+        else resolve_display_backend(mode, environment)
+    )
+    if resolution.backend == "proton":
+        return resolution
+
+    enabled = resolution.backend == "wayland"
+    # Set both aliases to the same value. Older runners read ENABLE only;
+    # newer runners may read USE after ENABLE, so leaving an alias behind is
+    # contradictory. Setting 0 also defeats runner user_settings defaults.
+    for key in _WAYLAND_KEYS:
+        environment[key] = "1" if enabled else "0"
+    environment["WINE_GRAPHICS_DRIVER"] = resolution.backend
+    environment.pop("PROTON_USE_X11_EXCLUSIVE", None)
+
+    for key in ("PROTON_ADD_CONFIG", "STEAM_COMPAT_CONFIG"):
+        value = environment.get(key)
+        if value is not None and any(
+            flag.strip().lower() == "wayland" for flag in value.split(",")
+        ):
+            environment[key] = ",".join(
+                flag for flag in value.split(",")
+                if flag.strip().lower() != "wayland"
+            )
+
+    overrides = _without_display_dll_overrides(
+        environment.get("WINEDLLOVERRIDES", "")
+    )
+    if enabled:
+        # Native Wayland OpenGL requires EGL. Let the runner handle its own
+        # launcher exceptions; do not disable winex11 globally on this path.
+        environment["WINE_USE_EGL"] = "1"
+    else:
+        # Also cover runners without Proton's Wayland switches and prefixes
+        # whose driver ordering prefers Wayland. Keep DISPLAY/WAYLAND_DISPLAY
+        # intact for non-Wine launcher/toolkit processes.
+        overrides = ";".join(
+            part for part in (overrides, "winewayland.drv=;winex11.drv=b") if part
+        )
+    if overrides:
+        environment["WINEDLLOVERRIDES"] = overrides
+    else:
+        environment.pop("WINEDLLOVERRIDES", None)
+    return resolution
